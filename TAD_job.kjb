      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>CREATE INDEX IF NOT EXISTS idx_stg_sending_org ON stg_erasmus_complete(sending_org);
CREATE INDEX IF NOT EXISTS idx_stg_receiving_org ON stg_erasmus_complete(receiving_org);
CREATE INDEX IF NOT EXISTS idx_stg_sending_city ON stg_erasmus_complete(sending_city, sending_country);
