    <entry>
      <name>Create d_date</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>ALTER TABLE d_date ALTER COLUMN dateid TYPE INTEGER;

TRUNCATE TABLE d_date RESTART IDENTITY CASCADE;

INSERT INTO d_date (dateid, full_date, year, month, semester, academicyear)
SELECT 
    (extract(year from datum) * 10000 + extract(month from datum) * 100 + 1)::int as dateid,
    datum::date as full_date,
    extract(year from datum)::int as year,
    extract(month from datum)::int as month,
    CASE WHEN extract(month from datum) &lt;= 6 THEN '1º Semestre' ELSE '2º Semestre' END as semester,
    CASE 
        WHEN extract(month from datum) >= 9 THEN extract(year from datum) || '/' || (extract(year from datum) + 1)
        ELSE (extract(year from datum) - 1) || '/' || extract(year from datum)
    END as academicyear
FROM generate_series('2010-01-01'::date, '2030-12-01'::date, '1 month'::interval) datum;</sql>
