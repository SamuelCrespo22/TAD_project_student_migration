      <sql>TRUNCATE TABLE stg_erasmus_complete;</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>T</sendOneStatement>
      <connection>tad_db</connection>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>208</xloc>
      <yloc>128</yloc>
      <attributes_kjc/>
    </entry>
    <entry>
      <name>(FACT) SQL</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>SET statement_timeout = 0;
SET work_mem = '128MB';

ANALYZE stg_erasmus_complete;
ANALYZE d_organization;
ANALYZE d_geography;
ANALYZE d_demographics;
ANALYZE d_education;

ALTER TABLE f_mobility DROP CONSTRAINT IF EXISTS f_mobility_sendingorganization_fkey;
ALTER TABLE f_mobility DROP CONSTRAINT IF EXISTS f_mobility_receivingorganization_fkey;
ALTER TABLE f_mobility DROP CONSTRAINT IF EXISTS f_mobility_sendinggeography_fkey;
ALTER TABLE f_mobility DROP CONSTRAINT IF EXISTS f_mobility_receivinggeography_fkey;
ALTER TABLE f_mobility DROP CONSTRAINT IF EXISTS f_mobility_demographicsid_fkey;
ALTER TABLE f_mobility DROP CONSTRAINT IF EXISTS f_mobility_educationid_fkey;
ALTER TABLE f_mobility DROP CONSTRAINT IF EXISTS f_mobility_startdate_fkey;


DROP INDEX IF EXISTS idx_f_mobility_startdate;
DROP INDEX IF EXISTS idx_f_mobility_sending_org;
DROP INDEX IF EXISTS idx_f_mobility_receiving_org;
DROP INDEX IF EXISTS idx_f_mobility_sending_geo;
DROP INDEX IF EXISTS idx_f_mobility_receiving_geo;
DROP INDEX IF EXISTS idx_f_mobility_demo;
DROP INDEX IF EXISTS idx_f_mobility_edu;
DROP INDEX IF EXISTS idx_f_mobility_activity;
DROP INDEX IF EXISTS idx_f_mobility_fewer_opp;

DELETE FROM f_mobility 
WHERE startdate >= 20220101 AND startdate &lt;= 20221201;

INSERT INTO f_mobility (
    startdate, 
    sendinggeography, 
    receivinggeography, 
    sendingorganization, 
    receivingorganization, 
    demographicsid, 
    educationid, 
    activityname, 
    mobilitydurationdays, 
    feweropportunitiesflag
)
SELECT 
    to_char(s.startdate_raw, 'YYYYMMDD')::int, 
    g_send.geographyid,
    g_rec.geographyid,
    o_send.organizationid,
    o_rec.organizationid,
    demo.demographicsid,
    edu.educationid,
    s.activityname,
    s.mobilitydurationdays,
    s.feweropportunitiesflag
FROM stg_erasmus_complete s
-- Joins Organization
LEFT JOIN d_organization o_send ON s.sending_org = o_send.organizationname
LEFT JOIN d_organization o_rec  ON s.receiving_org = o_rec.organizationname
-- Joins Geography
LEFT JOIN d_geography g_send ON s.sending_city = g_send.cityname AND s.sending_country = g_send.countryname
LEFT JOIN d_geography g_rec  ON s.receiving_city = g_rec.cityname AND s.receiving_country = g_rec.countryname
-- Joins Demographics and Education
LEFT JOIN d_demographics demo ON s.age = demo.age AND s.gender = demo.gender AND s.participantcountry = demo.participantcountry
LEFT JOIN d_education edu ON s.fieldofeducationname = edu.fieldofeducationname AND s.educationlevel = edu.educationlevel;

CREATE INDEX idx_f_mobility_startdate ON public.f_mobility USING btree (startdate);
CREATE INDEX idx_f_mobility_sending_org ON public.f_mobility USING btree (sendingorganization);
CREATE INDEX idx_f_mobility_receiving_org ON public.f_mobility USING btree (receivingorganization);
CREATE INDEX idx_f_mobility_sending_geo ON public.f_mobility USING btree (sendinggeography);
CREATE INDEX idx_f_mobility_receiving_geo ON public.f_mobility USING btree (receivinggeography);
CREATE INDEX idx_f_mobility_demo ON public.f_mobility USING btree (demographicsid);
CREATE INDEX idx_f_mobility_edu ON public.f_mobility USING btree (educationid);
CREATE INDEX idx_f_mobility_activity ON public.f_mobility USING btree (activityname);
CREATE INDEX idx_f_mobility_fewer_opp ON public.f_mobility USING btree (feweropportunitiesflag);

ALTER TABLE f_mobility ADD CONSTRAINT f_mobility_sendingorganization_fkey 
    FOREIGN KEY (sendingorganization) REFERENCES d_organization(organizationid);

ALTER TABLE f_mobility ADD CONSTRAINT f_mobility_receivingorganization_fkey 
    FOREIGN KEY (receivingorganization) REFERENCES d_organization(organizationid);

ALTER TABLE f_mobility ADD CONSTRAINT f_mobility_sendinggeography_fkey 
    FOREIGN KEY (sendinggeography) REFERENCES d_geography(geographyid);

ALTER TABLE f_mobility ADD CONSTRAINT f_mobility_receivinggeography_fkey 
    FOREIGN KEY (receivinggeography) REFERENCES d_geography(geographyid);

ALTER TABLE f_mobility ADD CONSTRAINT f_mobility_demographicsid_fkey 
    FOREIGN KEY (demographicsid) REFERENCES d_demographics(demographicsid);

ALTER TABLE f_mobility ADD CONSTRAINT f_mobility_educationid_fkey 
    FOREIGN KEY (educationid) REFERENCES d_education(educationid);

ALTER TABLE f_mobility ADD CONSTRAINT f_mobility_startdate_fkey 
    FOREIGN KEY (startdate) REFERENCES d_date(dateid);

VACUUM ANALYZE f_mobility;</sql>
