    <entry>
      <name>(DIMENSIONS) SQL</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>-- D_ORGANIZATION
INSERT INTO d_organization (organizationname, organizationtype)
SELECT DISTINCT org_name, org_type FROM (
    SELECT sending_org AS org_name, sending_org_type AS org_type FROM stg_erasmus_complete
    UNION
    SELECT receiving_org AS org_name, receiving_org_type AS org_type FROM stg_erasmus_complete
) AS u WHERE org_name IS NOT NULL
ON CONFLICT (organizationname) DO NOTHING;

-- D_GEOGRAPHY
INSERT INTO d_geography (cityname, countryname)
SELECT DISTINCT city, country FROM (
    SELECT sending_city AS city, sending_country AS country FROM stg_erasmus_complete
    UNION
    SELECT receiving_city AS city, receiving_country AS country FROM stg_erasmus_complete
) AS u WHERE city IS NOT NULL
ON CONFLICT (cityname, countryname) DO NOTHING;

-- D_EDUCATION
INSERT INTO d_education (fieldofeducationname, educationlevel)
SELECT DISTINCT fieldofeducationname, educationlevel 
FROM stg_erasmus_complete 
WHERE fieldofeducationname IS NOT NULL
ON CONFLICT (fieldofeducationname, educationlevel) DO NOTHING;

-- D_DEMOGRAPHICS
INSERT INTO d_demographics (age, agebracket, gender, participantcountry)
SELECT DISTINCT age, agebracket, gender, participantcountry 
FROM stg_erasmus_complete 
WHERE gender IS NOT NULL
ON CONFLICT (age, gender, participantcountry) DO NOTHING;</sql>
