    <outputField>agebracket</outputField>
    <fallBackValue>unknown</fallBackValue>
    <rules>
      <rule>
        <lower_bound>-1.7976931348623157E308</lower_bound>
        <upper_bound>21.0</upper_bound>
        <value>16-20</value>
      </rule>
      <rule>
        <lower_bound>21.0</lower_bound>
        <upper_bound>26.0</upper_bound>
        <value>21-25</value>
      </rule>
      <rule>
        <lower_bound>26.0</lower_bound>
        <upper_bound>31.0</upper_bound>
        <value>26-30</value>
      </rule>
      <rule>
        <lower_bound>31.0</lower_bound>
        <upper_bound>36.0</upper_bound>
        <value>31-35</value>
      </rule>
      <rule>
        <lower_bound>36.0</lower_bound>
        <upper_bound>41.0</upper_bound>
        <value>36-40</value>
      </rule>
      <rule>
        <lower_bound>41.0</lower_bound>
        <upper_bound>46.0</upper_bound>
        <value>41-45</value>
      </rule>
      <rule>
        <lower_bound>46.0</lower_bound>
        <upper_bound>1.7976931348623157E308</upper_bound>
        <value>46+</value>
      </rule>
    </rules>
