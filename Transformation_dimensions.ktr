      <yloc>512</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Create org_type</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>var index_sending = getInputRowMeta().indexOfValue("Sending Organization");
var index_receiving = getInputRowMeta().indexOfValue("Receiving Organization");

var sending_org_value = row[index_sending] == null ? null : row[index_sending].toString();
var receiving_org_value = row[index_receiving] == null ? null : row[index_receiving].toString();

var sending_org_type = "Other";
var receiving_org_type = "Other";

if (sending_org_value != null) {
    var s_upper = sending_org_value.toUpperCase();
    if (s_upper.indexOf("UNIVERSITY") >= 0 || s_upper.indexOf("UNIVERSIDADE") >= 0 || s_upper.indexOf("INSTITUTO") >= 0) {
        sending_org_type = "Higher Education Institution";
    } else if (s_upper.indexOf("SCHOOL") >= 0 || s_upper.indexOf("ESCOLA") >= 0) {
        sending_org_type = "School";
    } else if (s_upper.indexOf("RESEARCH") >= 0 || s_upper.indexOf("INVESTIGAÇÃO") >= 0) {
        sending_org_type = "Research Center";
    }
}


if (receiving_org_value != null) {
    var r_upper = receiving_org_value.toUpperCase();
    if (r_upper.indexOf("UNIVERSITY") >= 0 || r_upper.indexOf("UNIVERSIDADE") >= 0 || r_upper.indexOf("INSTITUTO") >= 0) {
        receiving_org_type = "Higher Education Institution";
    } else if (r_upper.indexOf("SCHOOL") >= 0 || r_upper.indexOf("ESCOLA") >= 0) {
        receiving_org_type = "School";
    } else if (r_upper.indexOf("RESEARCH") >= 0 || r_upper.indexOf("INVESTIGAÇÃO") >= 0) {
        receiving_org_type = "Research Center";
    }
}</jsScript_script>
      </jsScript>
    </jsScripts>
